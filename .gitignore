# ─────────────────────────────────────────────────────────────────────────────
# KAMP ⑤ 자원 최적화 — git 제외 대상
#
# 방침: 코드·데이터·문서·실행결과(outputs/)는 **모두 커밋**한다.
#       받는 사람이 직접 돌리지 않고도 결과를 볼 수 있어야 하기 때문이다.
#       실행 과정에서 생기는 중간 부산물만 제외한다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 실행 로그 (매 실행마다 바뀌고 내용이 재현 가능) ──────────────────────────
outputs/run.log
outputs/run_fast.log
outputs/finalize.log

# ── 재현성 검사 스냅샷 (tools/check_reproducibility.py 가 임시로 만든다) ─────
.cache/

# ── 학습된 모델 바이너리 (노트북이 재생성하며 용량만 차지) ───────────────────
outputs/models/

# ── 가이드북 재현 중간파일 ──────────────────────────────────────────────────
outputs/baseline_repro/

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ── 가상환경 ───────────────────────────────────────────────────────────────
.venv/
venv/
env/

# ── OS·에디터 ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
.vscode/
.idea/

# ── 작업 상태 폴더 (개발 도구가 만든 것) ────────────────────────────────────
.omc/
.omx/
